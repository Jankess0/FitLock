{
  "manifest_version": 3,
  "name": "FitLock",
  "version": "1.0.0",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["identity", "storage"],
  "host_permissions": ["https://www.strava.com/*"],
  "background": {
    "service_worker": "src/background/authService.ts",
    "type": "module"
  }
}