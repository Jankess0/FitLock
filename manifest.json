{
  "manifest_version": 3,
  "name": "FitLock",
  "version": "1.0.0",
  "action": {
    "default_popup": "index.html",
    "default_icon": "logo-128.png"
  },
  "permissions": ["identity", "storage", "tabs", "alarms"],
  "host_permissions": ["https://www.strava.com/*"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  }
}