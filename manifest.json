{
  "manifest_version": 3,
  "name": "FitLock",
  "version": "1.0.0",
  "action": {
    "default_popup": "index.html",
    "default_icon": "logo-128.png"
  },
  "permissions": ["identity", "storage", "tabs", "alarms", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}